<?xml version="1.0" ?>
<hex-merger version="1.0">
	<input>
		<name>Updater</name>
		<path>../updater_avr16eb32/Debug/kernelUpdater.hex</path>
		<range>
			<minimum>0x0F00</minimum>
			<maximum>0x114F</maximum>
		</range>
	</input>
	<input>
		<name>New Kernel</name>
		<path>Debug/tinyloader.hex</path>
		<range>
			<minimum>0x0000</minimum>
			<maximum>0x0EFF</maximum>
		</range>
		<offset>0x1150</offset>
	</input>
	<output>
		<path>Debug/notAus_kernelUpdate.hex</path>
	</output>
</hex-merger>